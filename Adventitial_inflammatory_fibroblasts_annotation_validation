    "# ==============================================================================\n",
    "# FIXED HELPER: NATIVE UNICODE SUPERSCRIPT EXPONENTS FOR MATPLOTLIB CELLS\n",
    "# ==============================================================================\n",
    "def format_p_value_exponent(pval_val):\n",
    "    try:\n",
    "        val = float(pval_val)\n",
    "        if val == 0:\n",
    "            return \"0.00\"\n",
    "        s = f\"{val:.2e}\"\n",
    "        base, exp = s.split('e')\n",
    "        exp_int = int(exp)\n",
    "        \n",
    "        # Native Unicode map for superscripts and negative signs\n",
    "        superscript_map = {\n",
    "            '-': '⁻', '0': '⁰', '1': '¹', '2': '²', '3': '³', \n",
    "            '4': '⁴', '5': '⁵', '6': '⁶', '7': '⁷', '8': '⁸', '9': '⁹'\n",
    "        }\n",
    "        \n",
    "        # Convert exponent integer into native unicode string symbols\n",
    "        exp_str = str(exp_int)\n",
    "        unicode_exp = \"\".join(superscript_map.get(char, char) for char in exp_str)\n",
    "        \n",
    "        # Returns crisp, clean native text: e.g., \"1.62 × 10⁻⁴⁹\"\n",
    "        return f\"{base} \\u00d7 10{unicode_exp}\"\n",
    "    except:\n",
    "        return str(pval_val)\n",
