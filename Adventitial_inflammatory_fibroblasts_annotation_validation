    "fibroblast_clusters = ['Alveolar', 'Adventitial', 'Inflammatory', 'CTHRC1+']\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. GLOBAL ONE-VS-REST BASE SELECTION\n",
    "# ==============================================================================\n",
    "print(\"Extracting global One-vs-Rest upregulated sets...\")\n",
    "sc.tl.rank_genes_groups(adata, groupby='annotation', method='wilcoxon', use_raw=False)\n",
    "\n",
    "# Helper to grab significant upregulated genes from Scanpy's active slot\n",
    "def get_ovr_genes(cluster_name):\n",
    "    df = pd.DataFrame({\n",
    "        'Gene': adata.uns['rank_genes_groups']['names'][cluster_name],\n",
    "        'LogFC': adata.uns['rank_genes_groups']['logfoldchanges'][cluster_name],\n",
    "        'p_adj': adata.uns['rank_genes_groups']['pvals_adj'][cluster_name]\n",
    "    })\n",
    "    return set(df[(df['LogFC'] > 0) & (df['p_adj'] < 0.05)]['Gene'])\n",
    "\n",
    "global_adv_set = get_ovr_genes('Adventitial')\n",
    "global_inf_set = get_ovr_genes('Inflammatory')\n",
    "\n",
    "# ==============================================================================\n",
    "# 2. PAIRWISE CONTRAST FUNCTION (PURE STATS ONLY)\n",
    "# ==============================================================================\n",
    "def get_pairwise_upregulated_genes(target_cluster, background_cluster):\n",
    "    # Subset to isolate the pair\n",
    "    adata_sub = adata[adata.obs['annotation'].isin([target_cluster, background_cluster])].copy()\n",
    "    \n",
    "    # Run direct 1-vs-1 contrast\n",
    "    sc.tl.rank_genes_groups(\n",
    "        adata_sub, groupby='annotation', groups=[target_cluster], \n",
    "        reference=background_cluster, method='wilcoxon', use_raw=False\n",
    "    )\n",
    "    \n",
    "    df = pd.DataFrame({\n",
    "        'Gene': adata_sub.uns['rank_genes_groups']['names'][target_cluster],\n",
    "        'LogFC': adata_sub.uns['rank_genes_groups']['logfoldchanges'][target_cluster],\n",
    "        'p_adj': adata_sub.uns['rank_genes_groups']['pvals_adj'][target_cluster]\n",
    "    })\n",
    "    \n",
    "    # Return strictly unique, significant upregulated genes\n",
    "    return set(df[(df['LogFC'] > 0) & (df['p_adj'] < 0.05)]['Gene'])\n",
    "\n",
    "# ==============================================================================\n",
    "# 3. INTERSECT GRAPH TRAVERSAL\n",
    "# ==============================================================================\n",
    "print(\"\\nRunning multi-pairwise intersections for Adventitial...\")\n",
