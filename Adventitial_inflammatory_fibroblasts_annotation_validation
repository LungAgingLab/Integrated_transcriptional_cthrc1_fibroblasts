    "    if clus != 'Inflammatory':\n",
    "        pair_set = get_pairwise_upregulated_genes('Inflammatory', clus)\n",
    "        final_inf_set = final_inf_set.intersection(pair_set) # Equivalent to intersect()\n",
    "        print(f\"   -> Retained after intersection with '{clus}': {len(final_inf_set)}\")\n",
    "\n",
    "# Convert finalized unique sets to list formats for cell scoring\n",
    "final_adv_list = list(final_adv_set)\n",
