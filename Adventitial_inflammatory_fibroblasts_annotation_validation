    "# This script computes two critical single-cell metrics for each marker across \n",
    "# the 'Adventitial' and 'Inflammatory' clusters:\n",
    "#   1. Percent Expressed (%): The exact proportion of individual cells with non-zero\n",
    "#      transcript counts (>0) for a given gene.\n",
    "#   2. Median Intensity: The median expression level computed exclusively among \n",
    "#      the cells that actively express the gene (excluding zero inflation).\n",
    "#\n",
    "# CRITERIA: Used to directly evaluate and refute the referee's claim of \n",
    "# marker enrichment anomalies by providing un-averaged cell distribution counts.\n",
    "# ==============================================================================\n",
    "\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "\n",
    "# 1. Isolate the exact cells belonging to the target clusters\n",
    "target_cells = adata[adata.obs['annotation'].isin(['Adventitial', 'Inflammatory'])].copy()\n",
    "\n",
    "# 2. FIX: Extract expression directly into a DataFrame to prevent index-scrambling bugs\n",
    "df_cells = target_cells[:, target_markers].to_df()\n",
    "df_cells['Cluster'] = target_cells.obs['annotation'].values\n",
    "\n",
    "# 3. Calculate (A) Percent of cells expressing (>0) and (B) Median intensity when expressed\n",
    "diagnostic_results = []\n",
    "\n",
    "for cluster in ['Adventitial', 'Inflammatory']:\n",
    "    cluster_df = df_cells[df_cells['Cluster'] == cluster]\n",
