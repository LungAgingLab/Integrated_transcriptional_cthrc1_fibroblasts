    "# ==============================================================================\n",
    "# PIPELINE: MULTI-PAIRWISE INTEGRATION & SINGLE-CELL GENE MODULE SCORING\n",
    "# ==============================================================================\n",
    "# PURPOSE: Identify the top 15 most robust consensus marker genes for \n",
