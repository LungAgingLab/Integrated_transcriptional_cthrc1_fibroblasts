    "        pair_set = get_pairwise_upregulated_genes('Adventitial', clus)\n",
    "        final_adv_set = final_adv_set.intersection(pair_set) # Equivalent to intersect()\n",
    "        print(f\"   -> Retained after intersection with '{clus}': {len(final_adv_set)}\")\n",
