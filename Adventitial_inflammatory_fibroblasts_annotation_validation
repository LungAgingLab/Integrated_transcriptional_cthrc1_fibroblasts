    "#\n",
    "# STRATEGY & METRICS:\n",
    "#   1. Global Initialization: Establishes a baseline gene set using a global \n",
    "#      One-vs-Rest Wilcoxon test (LogFC > 0, adjusted p-value < 0.05).\n",
    "#   2. Iterative Set Intersection: Slices out individual 1-vs-1 binary contrasts \n",
    "#      against all alternative fibroblast lineages to isolate pure specific markers:\n",
    "#        - Adventitial is intersected with:\n",
    "#          * Adventitial vs. Alveolar\n",
    "#          * Adventitial vs. Inflammatory\n",
    "#          * Adventitial vs. CTHRC1+\n",
    "#        - Inflammatory is intersected with:\n",
    "#          * Inflammatory vs. Alveolar\n",
    "#          * Inflammatory vs. Adventitial\n",
    "#          * Inflammatory vs. CTHRC1+\n",
    "#   3. Binary Filtering: Systematically applies a set `.intersection()` loop. \n",
    "#      A gene is discarded if it fails to maintain strict significance \n",
    "#      (LogFC > 0, adjusted p-value < 0.05) in any single head-to-head match.\n",
    "#   4. Unranked Aggregation: Scores cells based on the entire population of surviving \n",
    "#      genes simultaneously using sc.tl.score_genes, bypassing top-N slice limits.\n",
    "# ==============================================================================\n",
    "import scanpy as sc\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Define standard cluster paths\n",
    "plotdir = \"/fs/ess/PAS2148/Projects_Mora_Rojas_Lab/Mayo/Plots/\"\n",
