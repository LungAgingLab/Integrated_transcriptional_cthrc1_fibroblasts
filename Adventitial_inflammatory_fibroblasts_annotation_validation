   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Generating 3-panel stacked condition MatrixPlot...\n",
      "Successfully exported 3-panel stacked matrix plot to: /fs/ess/PAS2148/Projects_Mora_Rojas_Lab/Mayo/Plots/Referee1_3Panel_Stacked_Conditions_Matrixplot.pdf\n"
     ]
    }
   ],
   "source": [
    "# ==============================================================================\n",
    "# PURPOSE: Re-evaluating diagnostic marker gene expression (\"PI16\", \"SFRP2\", etc.)\n",
    "# specifically within 'Adventitial' and 'Inflammatory' fibroblasts to address\n",
    "# a Peer Reviewer's request (Referee 1).\n",
    "# \n",
    "# Cross-stratify cell types by tissue status and region (Healthy vs. IPF LL vs. IPF UL)\n",
    "# to see if canonical adventitial markers (SFRP2, PI16) behave abnormally or drift\n",
    "# into the inflammatory cluster under pathological states, addressing Referee 1.\n",
    "# ==============================================================================\n",
    "import scanpy as sc\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# 1. Define conditions based on your Status metadata distribution\n",
    "status_groups = ['Healthy', 'IPF LL', 'IPF UL']\n",
    "target_markers = [\"PI16\", \"SFRP2\", \"ITGA8\", \"CCL2\", \"MFAP5\"]\n",
    "\n",
    "# Subset your fibroblast lineages once to save memory\n",
    "adata_sub = adata[adata.obs['annotation'].isin(['Adventitial', 'Inflammatory'])].copy()\n",
    "\n",
    "# 2. Set up the matplotlib grid (3 rows, 1 column)\n",
    "fig, axes = plt.subplots(nrows=3, ncols=1, figsize=(6, 12), sharex=True)\n",
    "plt.subplots_adjust(hspace=0.4)  # Clean vertical spacing between panels\n",
    "\n",
    "print(\"Generating 3-panel stacked condition MatrixPlot...\")\n",
    "\n",
    "# 3. Populate each panel iteratively by slicing your real Status column\n",
    "for i, status in enumerate(status_groups):\n",
    "    # Slice data for the specific cohort status\n",
    "    adata_status = adata_sub[adata_sub.obs['Status'] == status]\n",
    "    \n",
    "    # Render the matrixplot directly into the designated subplot axis\n",
    "    sc.pl.matrixplot(\n",
    "        adata_status,\n",
    "        var_names=target_markers,\n",
    "        groupby='annotation',\n",
    "        cmap='viridis',\n",
    "        use_raw=False,\n",
    "        ax=axes[i],       # Crucial: Forces Scanpy onto the specific row panel\n",
    "        show=False\n",
    "    )\n",
    "    \n",
    "    # Label each plot panel to clearly show the condition being mapped\n",
    "    axes[i].set_title(f\"Status: {status}\", fontsize=12, pad=10)\n",
    "\n",
    "# 4. Save and clean the global figure canvas\n",
    "plotdir = \"/fs/ess/PAS2148/Projects_Mora_Rojas_Lab/Mayo/Plots/\"\n",
    "stacked_output = plotdir + \"Referee1_3Panel_Stacked_Conditions_Matrixplot.pdf\"\n",
    "\n",
    "fig.savefig(stacked_output, bbox_inches='tight', dpi=300)\n",
    "plt.close('all')\n",
    "\n",
    "print(f\"Successfully exported 3-panel stacked matrix plot to: {stacked_output}\")\n"
   ]
  },
