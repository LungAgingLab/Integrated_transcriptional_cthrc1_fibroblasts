   "source": [
    "import scanpy as sc\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Define your standard cluster paths\n",
    "datadir = \"/fs/ess/PAS2148/Projects_Mora_Rojas_Lab/Mayo/\"\n",
    "plotdir = \"/fs/ess/PAS2148/Projects_Mora_Rojas_Lab/Mayo/Plots/\"\n",
    "\n",
    "# Target genes to evaluate\n",
    "target_markers = [\"PI16\", \"SFRP2\", \"ITGA8\", \"CCL2\", \"MFAP5\"]\n",
    "\n",
    "print(\"Generating marker diagnostic MatrixPlot...\")\n",
    "\n",
    "# FIX 1: Subset once in memory to avoid repetitive slicing overhead\n",
    "adata_sub = adata[adata.obs['annotation'].isin(['Adventitial', 'Inflammatory'])].copy()\n",
