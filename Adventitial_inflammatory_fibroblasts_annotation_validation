    "        expressed_cells = np.sum(gene_expr > 0)\n",
    "        \n",
    "        # Calculate percent of cells turned \"on\"\n",
    "        pct_expressed = (expressed_cells / total_cells_in_cluster) * 100\n",
    "        \n",
    "        # Calculate median expression level ONLY among the cells expressing it\n",
