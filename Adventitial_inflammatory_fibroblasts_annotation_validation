    "#      to isolate the top 15 most consistent markers.\n",
    "#   4. Module Expression Scoring: Uses sc.tl.score_genes to project aggregate \n",
    "#      signature expression onto the single-cell UMAP matrix.\n",
    "# ==============================================================================\n",
    "import scanpy as sc\n",
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "# Define your standard cluster paths\n",
    "plotdir = \"/fs/ess/PAS2148/Projects_Mora_Rojas_Lab/Mayo/Plots/\"\n",
    "\n",
    "# Define the 4 core fibroblast clusters to evaluate\n",
    "fibroblast_clusters = ['Alveolar', 'Adventitial', 'Inflammatory', 'CTHRC1+']\n",
    "\n",
    "# ==============================================================================\n",
    "# 1. HELPER FUNCTION TO EXTRACT UNFILTERED PAIRWISE SCORES\n",
    "# ==============================================================================\n",
    "def get_raw_pairwise_rankings(target_cluster, background_cluster):\n",
    "    # Isolate just the two specific clusters for a clean 1-vs-1 contrast\n",
    "    adata_sub = adata[adata.obs['annotation'].isin([target_cluster, background_cluster])].copy()\n",
    "    \n",
    "    # Run direct 1-vs-1 Wilcoxon test\n",
    "    sc.tl.rank_genes_groups(\n",
    "        adata_sub, groupby='annotation', groups=[target_cluster], \n",
    "        reference=background_cluster, method='wilcoxon', use_raw=False\n",
    "    )\n",
    "    \n",
    "    # Extract the raw, unfiltered data table\n",
    "    df = pd.DataFrame({\n",
    "        'Gene': adata_sub.uns['rank_genes_groups']['names'][target_cluster],\n",
    "        'Score': adata_sub.uns['rank_genes_groups']['scores'][target_cluster],\n",
    "        'LogFC': adata_sub.uns['rank_genes_groups']['logfoldchanges'][target_cluster]\n",
    "    })\n",
    "    \n",
    "    # Filter for positive enrichment (LogFC > 0) to capture only upregulated markers\n",
    "    df = df[df['LogFC'] > 0].copy()\n",
    "    \n",
    "    # Sort strictly by the statistical Wilcoxon z-score descending\n",
    "    df = df.sort_values(by='Score', ascending=False)\n",
