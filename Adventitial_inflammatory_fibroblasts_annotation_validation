    "    title=\"Re-evaluating Adventitial vs Inflammatory Markers\",\n",
    "    cmap='viridis',\n",
    "    use_raw=False,\n",
    "    show=False\n",
    ")\n",
    "\n",
    "# Export cleanly using the explicit matplotlib figure object generated by Scanpy\n",
